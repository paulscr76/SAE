{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/command-centre.html",
      "destination": "/command-centre",
      "permanent": true
    },
    {
      "source": "/bill-helper.html",
      "destination": "/bill-helper",
      "permanent": true
    },
    {
      "source": "/calculator.html",
      "destination": "/calculator",
      "permanent": true
    },
    {
      "source": "/guides.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/review",
      "destination": "/command-centre",
      "permanent": true
    },
    {
      "source": "/review.html",
      "destination": "/command-centre",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|webp|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}